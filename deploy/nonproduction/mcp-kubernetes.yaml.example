# Secret-free example for the first bounded BAU read route. The token and TLS
# Secrets must be provisioned separately by the private secret/certificate
# system. The certificate must be trusted by the control-plane runtime.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: agenova-mcp-kubernetes
  namespace: agenova-nonprod
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agenova-mcp-kubernetes
  namespace: agenova-nonprod
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: agenova-mcp-kubernetes}
  template:
    metadata:
      labels: {app.kubernetes.io/name: agenova-mcp-kubernetes}
    spec:
      serviceAccountName: agenova-mcp-kubernetes
      automountServiceAccountToken: true
      securityContext:
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: mcp
          image: registry.example/agenova/mcp-kubernetes@sha256:2222222222222222222222222222222222222222222222222222222222222222
          imagePullPolicy: IfNotPresent
          env:
            - {name: AGENOVA_MCP_NAMESPACE, value: monitoring}
            - {name: AGENOVA_MCP_ALLOWED_KINDS, value: "deployments,pods"}
            - {name: AGENOVA_MCP_BEARER_TOKEN_FILE, value: /var/run/agenova-auth/token}
            - {name: AGENOVA_MCP_TLS_CERT_FILE, value: /var/run/agenova-tls/tls.crt}
            - {name: AGENOVA_MCP_TLS_KEY_FILE, value: /var/run/agenova-tls/tls.key}
          ports:
            - {name: https, containerPort: 8080}
          readinessProbe:
            httpGet: {path: /readyz, port: https, scheme: HTTPS}
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /readyz, port: https, scheme: HTTPS}
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests: {cpu: 25m, memory: 32Mi}
            limits: {cpu: 250m, memory: 128Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
          volumeMounts:
            - {name: auth, mountPath: /var/run/agenova-auth, readOnly: true}
            - {name: tls, mountPath: /var/run/agenova-tls, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: auth
          secret: {secretName: agenova-mcp-token}
        - name: tls
          secret: {secretName: agenova-mcp-tls}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: agenova-mcp-kubernetes
  namespace: agenova-nonprod
spec:
  selector: {app.kubernetes.io/name: agenova-mcp-kubernetes}
  ports:
    - {name: https, port: 8443, targetPort: https}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: agenova-mcp-kubernetes-read
  namespace: monitoring
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list]
  - apiGroups: [apps]
    resources: [deployments]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: agenova-mcp-kubernetes-read
  namespace: monitoring
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: agenova-mcp-kubernetes-read
subjects:
  - kind: ServiceAccount
    name: agenova-mcp-kubernetes
    namespace: agenova-nonprod
