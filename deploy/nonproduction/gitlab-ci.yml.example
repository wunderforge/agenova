# Secret-free reusable job shape. Copy into a private deployment repository.
stages: [validate, render, plan, verify]

.agenova:
  image: registry.example/agenova/deployer@sha256:2222222222222222222222222222222222222222222222222222222222222222
  variables:
    AGENOVA_PLATFORM_FILE: deploy/nonproduction/platform.yaml
    AGENOVA_STATE_DIR: .agenova-state
    # Set this in the private pipeline to its reviewed v0.4.6 image reference.
    AGENOVA_EXPECTED_AGENT_SANDBOX_CONTROLLER_IMAGE: registry.example/agent-sandbox/controller@sha256:3333333333333333333333333333333333333333333333333333333333333333
  artifacts:
    when: always
    paths: [.agenova-state/]

agenova:validate:
  extends: .agenova
  stage: validate
  script: ["deploy/nonproduction/verify.sh validate"]

agenova:plan:
  extends: .agenova
  stage: plan
  script: ["deploy/nonproduction/verify.sh plan"]

agenova:prerequisites:
  extends: .agenova
  stage: plan
  script: ["deploy/nonproduction/verify.sh prerequisites"]

agenova:render:
  extends: .agenova
  stage: render
  variables:
    AGENOVA_RENDERED_FILE: rendered/agenova.yaml
  script: ["deploy/nonproduction/verify.sh render"]
  artifacts:
    paths: [rendered/agenova.yaml]

agenova:verify:
  extends: .agenova
  stage: verify
  when: manual
  script: ["deploy/nonproduction/verify.sh verify"]
