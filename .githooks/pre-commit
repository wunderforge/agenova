#!/usr/bin/env sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File ./scripts/check.ps1 -Profile Fast -ChangedOnly
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/check.ps1 -Profile Fast -ChangedOnly
fi

echo "Agenova pre-commit requires PowerShell (pwsh or powershell.exe)." >&2
exit 1
