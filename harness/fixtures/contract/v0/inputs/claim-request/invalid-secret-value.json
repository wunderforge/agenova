{
  "apiVersion": "agenova.io/v1alpha1",
  "kind": "ClaimRequest",
  "metadata": {"name": "fix-payment-timeout"},
  "spec": {
    "templateRef": "engineer",
    "task": {
      "type": "repository-change",
      "input": {"repository": "acme/payments", "objective": "Fix the payment timeout bug"}
    },
    "requestedAccess": {"tools": ["git.read"]},
    "runtime": {"profileRef": "standard-isolated", "timeout": "20m"},
    "secrets": {"githubToken": "DO_NOT_USE_FIXTURE_SECRET_VALUE"}
  }
}
