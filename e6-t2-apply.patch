+	authority := runCLI(t, bin, 2, "run", "-f", fixture, "--repo=acme/payments")
+	if !strings.Contains(authority, "does not grant authority through CLI flags") {
+		t.Fatalf("authority flag: %q", authority)
+	}
+
+	missing := runCLI(t, bin, 2, "run")
