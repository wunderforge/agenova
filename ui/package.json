{
  "name": "@agenova/fixture-storyboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.1 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check && vitest run src/fixture-source.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "node scripts/contracts.mjs check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:smoke": "playwright test",
    "browsers:install": "playwright install chromium",
    "check": "npm run contracts:check && npm run typecheck && npm test -- --run && npm run build && npm run test:smoke"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
